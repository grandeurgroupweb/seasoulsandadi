# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is git-ignored. Never commit real keys or paste them into chat.

# Public (shipped to the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — used ONLY by `npm run seed:images` on your machine. Never set this in Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (Vercel domain until a custom domain is connected)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
